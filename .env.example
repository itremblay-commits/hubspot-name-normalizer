# ── HubSpot App Signing Secret ──────────────────────────────────────────────
# Used to verify that incoming webhook requests actually came from HubSpot.
# After uploading the project with `hs project upload`, find this at:
#   developers.hubspot.com → Apps → Name Normalizer → Auth → Client secret
HUBSPOT_CLIENT_SECRET=

# ── HubSpot Portal Access Token ─────────────────────────────────────────────
# Used to read and update contact properties via the CRM API.
# After installing the app on your portal, find this token at:
#   developers.hubspot.com → Apps → Name Normalizer → (install the app)
# Or in your HubSpot portal:
#   Settings → Integrations → Private Apps → Name Normalizer → Access token
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write
HUBSPOT_PRIVATE_APP_TOKEN=
